# Sanity CMS (public, read-only dataset — never put a Sanity token here)
REACT_APP_SANITY_PROJECT_ID=your_sanity_project_id
REACT_APP_SANITY_DATASET=production

# EmailJS (Get Involved volunteer form)
REACT_APP_EMAILJS_SERVICE_ID=your_emailjs_service_id
REACT_APP_EMAILJS_TEMPLATE_ID=your_emailjs_template_id
REACT_APP_EMAILJS_USER_KEY=your_emailjs_user_key

# Sentry error tracking (sentry.io → Project → Settings → Client Keys)
REACT_APP_SENTRY_DSN=your_sentry_dsn
